# Server
APP_ENV=development
PORT=8080
SHUTDOWN_TIMEOUT_SECONDS=10
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=postgres://gravehard:gravehard@localhost:5432/gravehard?sslmode=disable
DB_MAX_CONNS=15
DB_MIN_CONNS=2
DB_QUERY_TIMEOUT_SECONDS=5

# Auth
JWT_SECRET=replace-with-a-32-byte-random-secret-in-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Rate Limiting (requests per minute)
RATE_LIMIT_GENERAL_RPM=120
RATE_LIMIT_AUTH_RPM=20
RATE_LIMIT_DEMO_RPM=60

# Frontend
VITE_API_URL=http://localhost:8080/api/v1
